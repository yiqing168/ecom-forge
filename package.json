{
  "name": "ecom-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Conversation-first AI creation platform for ecommerce teams",
  "engines": {
    "node": ">=22.22 <23"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo dev --concurrency=20",
    "build": "turbo build",
    "lint": "pnpm lint:root && turbo lint",
    "lint:root": "eslint scripts *.mjs",
    "lint:fix": "pnpm lint:root --fix && turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=2",
    "test:integration": "turbo test:integration",
    "test:worker": "turbo test:worker",
    "test:e2e": "pnpm --filter @ecom-forge/web test:e2e",
    "test:e2e:s03-live": "pnpm --filter @ecom-forge/web test:e2e:s03-live",
    "test:e2e:s06-live": "pnpm --filter @ecom-forge/web test:e2e:s06-live",
    "test:e2e:s10-live": "pnpm --filter @ecom-forge/web test:e2e:s10-live",
    "test:e2e:s11-live": "pnpm --filter @ecom-forge/web test:e2e:s11-live",
    "test:e2e:s12-live": "pnpm --filter @ecom-forge/web test:e2e:s12-live",
    "test:e2e:s14-live": "pnpm --filter @ecom-forge/admin test:e2e:s14-live",
    "test:load": "node scripts/validation/load-smoke.mjs",
    "validate:worker-recovery": "pnpm --filter @ecom-forge/worker validate:worker-recovery",
    "validate:webhook-lost": "pnpm --filter @ecom-forge/worker validate:webhook-lost",
    "validate:provider-timeout": "pnpm --filter @ecom-forge/worker validate:provider-timeout",
    "poc:agent-brain": "pnpm --filter @ecom-forge/worker poc:agent-brain",
    "poc:provider:image": "pnpm --filter @ecom-forge/worker poc:provider:image",
    "poc:provider:edit": "pnpm --filter @ecom-forge/worker poc:provider:edit",
    "poc:provider:moderation": "pnpm --filter @ecom-forge/worker poc:provider:moderation",
    "validate:cost-report": "pnpm --filter @ecom-forge/provider exec vitest run src/provider.spec.ts -t \"uses decimal arithmetic and rounds credits upward\"",
    "validate:agent-trace-loop": "node scripts/validation/run-s08-case.mjs agent-trace-loop",
    "validate:agent-session-transcript": "node scripts/validation/run-s08-case.mjs agent-session-transcript",
    "validate:agent-cost-exposure": "node scripts/validation/run-s08-case.mjs agent-cost-exposure",
    "validate:skill-load-cache": "node scripts/validation/run-s08-case.mjs skill-load-cache",
    "validate:skill-package-install": "node scripts/validation/run-s08-case.mjs skill-package-install",
    "validate:golden-eval-gate": "node scripts/validation/run-s08-case.mjs golden-eval-gate",
    "validate:compiler-r1-r5": "node scripts/validation/run-s09-case.mjs compiler-r1-r5",
    "validate:compiler-concurrency": "node scripts/validation/run-s09-case.mjs compiler-concurrency",
    "validate:compiler-cost-snapshot": "node scripts/validation/run-s09-case.mjs compiler-cost-snapshot",
    "validate:image-pipeline": "node scripts/validation/image-pipeline.mjs",
    "validate:creative-chat": "pnpm --filter @ecom-forge/compiler exec vitest run src/creative-profiles.spec.ts src/compile-plan.spec.ts && pnpm --filter @ecom-forge/worker exec vitest run --config vitest.config.ts src/image/approved-image-prompt.spec.ts src/image/image-output-ingest.service.spec.ts && node scripts/validation/run-s09-case.mjs compiler-cost-snapshot",
    "skill:scaffold": "pnpm --filter @ecom-forge/skills skill:scaffold",
    "skill:discover": "pnpm --filter @ecom-forge/skills skill:discover",
    "skill:sync": "pnpm --filter @ecom-forge/skills skill:sync",
    "skill:pack": "pnpm --filter @ecom-forge/skills skill:pack",
    "skill:validate": "pnpm --filter @ecom-forge/skills skill:validate",
    "skill:diff": "pnpm --filter @ecom-forge/skills skill:diff",
    "skill:install": "pnpm --filter @ecom-forge/api skill:install",
    "validate:skill-content": "pnpm --filter @ecom-forge/skills validate:skill-content",
    "validate:single-dispatch": "node scripts/validation/run-s04-case.mjs single-dispatch",
    "validate:duplicate-click": "node scripts/validation/run-s04-case.mjs duplicate-click",
    "validate:ledger-replay": "node scripts/validation/run-s04-case.mjs ledger-replay",
    "ops:queue-reconcile": "pnpm --filter @ecom-forge/worker ops:queue-reconcile",
    "ops:bootstrap-admin": "pnpm --filter @ecom-forge/api ops:bootstrap-admin",
    "ops:approve-provider-model": "pnpm --filter @ecom-forge/api ops:approve-provider-model",
    "ops:register-provider-model": "pnpm --filter @ecom-forge/api ops:register-provider-model",
    "ops:recover-provider-circuit": "pnpm --filter @ecom-forge/api ops:recover-provider-circuit",
    "db:check": "pnpm --filter @ecom-forge/db db:check",
    "db:generate": "pnpm --filter @ecom-forge/db db:generate",
    "db:migrate": "pnpm --filter @ecom-forge/db db:migrate",
    "db:status": "pnpm --filter @ecom-forge/db db:status",
    "design:detect": "impeccable detect --viewport 1440x900 http://127.0.0.1:3000",
    "design:detect:json": "impeccable detect --json --viewport 1440x900 http://127.0.0.1:3000",
    "design:detect:mobile": "impeccable detect --viewport 390x844 http://127.0.0.1:3000",
    "design:detect:mobile:json": "impeccable detect --json --viewport 390x844 http://127.0.0.1:3000",
    "design:detect:source": "impeccable detect apps/web",
    "validate:stage0": "node scripts/validation/stage0.mjs",
    "validate:quality-gates": "node scripts/validation/quality-gates.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:quality-gates",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "cz-git": {
    "scopes": [
      "web",
      "api",
      "worker",
      "db",
      "agent",
      "compiler",
      "credit",
      "provider",
      "queue",
      "skills",
      "docs"
    ],
    "allowCustomScopes": false,
    "allowEmptyScopes": true,
    "useEmoji": false,
    "maxHeaderLength": 100
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md,css,scss}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "impeccable": "3.5.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.9",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
