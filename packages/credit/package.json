{
  "name": "@ecom-forge/credit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecom-forge/db": "workspace:*",
    "@ecom-forge/shared": "workspace:*",
    "@ecom-forge/types": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
