{
  "name": "@ecom-forge/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./agent-public-contract": {
      "types": "./src/agent-public-contract.ts",
      "development": "./src/agent-public-contract.ts",
      "default": "./dist/agent-public-contract.js"
    },
    "./creative-direction": {
      "types": "./src/creative-direction.ts",
      "development": "./src/creative-direction.ts",
      "default": "./dist/creative-direction.js"
    },
    "./money": {
      "types": "./src/money.ts",
      "development": "./src/money.ts",
      "default": "./dist/money.js"
    },
    "./secret-envelope": {
      "types": "./src/secret-envelope.ts",
      "development": "./src/secret-envelope.ts",
      "default": "./dist/secret-envelope.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:worker": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
