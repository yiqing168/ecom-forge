{
  "name": "@ecom-forge/provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:worker": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ecom-forge/agent": "workspace:*",
    "@ecom-forge/shared": "workspace:*",
    "@ai-sdk/anthropic": "4.0.8",
    "@ai-sdk/google": "4.0.8",
    "@ai-sdk/openai": "4.0.8",
    "ai": "7.0.16",
    "decimal.js": "10.6.0",
    "js-tiktoken": "1.0.21",
    "zod": "4.4.3"
  }
}
