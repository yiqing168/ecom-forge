# Public deployment template, not a working secret file. For local development run:
#   node scripts/setup-local.mjs
# This creates a private .env.local with independent random keys and Compose connections.
# Existing .env.local files are never overwritten. Do not regenerate keys for an existing database.
# Only deployment inputs belong here. Runtime limits and queue defaults live in typed config.
# Inject each process's minimum subset; do not mount this whole file into every container.
APP_ENV=local
DATABASE_URL=postgresql://user:password@localhost:5432/ecom_forge
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ecom-forge
WEB_ORIGIN=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ADMIN_ORIGIN=http://127.0.0.1:3002
ADMIN_ALLOWED_HOSTS=localhost:3002,127.0.0.1:3002
TRUSTED_ADMIN_PROXY_CIDRS=127.0.0.1/32,::1/128
ADMIN_NETWORK_GATE_MODE=source_allowlist
ADMIN_SOURCE_ALLOWLIST_CIDRS=127.0.0.1/32,::1/128
ADMIN_COOKIE_SECURE=false
# Set exact HTTPS origins before configuring real models, e.g. https://api.provider.example.
# Local startup permits an empty allowlist; it does not grant access to arbitrary hosts.
PROVIDER_RELAY_ORIGINS=
# HTTPS origins allowed for Provider-returned image URLs. Each entry is an exact
# origin, or a single-domain wildcard like https://*.provider-output.example.com trusting one provider
# domain family (for example relay file pools under the operator domain).
PROVIDER_IMAGE_OUTPUT_ORIGINS=

# Local Worker dev sets its own consumption switches in apps/worker/scripts/dev.mjs.
# Production must inject PROVIDER_PROCESSOR_MODE=real and AGENT_PROCESSOR_ENABLED=true
# into the Worker process only, not into the API's shared environment.

# Required server secret domains. Use a distinct random base64url value for every domain.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_OTP_HASH_SECRET=replace-with-32-byte-base64url-secret
AUTH_RATE_LIMIT_SECRET=replace-with-32-byte-base64url-secret
AUTH_VERIFICATION_TICKET_SECRET=replace-with-32-byte-base64url-secret
AUTH_INVITE_CODE_ACTIVE_KEY_ID=invite-v1
AUTH_INVITE_CODE_KEYRING=invite-v1:replace-with-32-byte-base64url-secret
AUTH_REWARD_FINGERPRINT_ACTIVE_KEY_ID=fingerprint-v1
AUTH_REWARD_FINGERPRINT_KEYRING=fingerprint-v1:replace-with-32-byte-base64url-secret
RESOURCE_CURSOR_SECRET=replace-with-32-byte-base64url-secret
RESOURCE_IDEMPOTENCY_SECRET=replace-with-32-byte-base64url-secret
STORAGE_CAPABILITY_SECRET=replace-with-32-byte-base64url-secret

PROVIDER_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=provider-credential-v1
PROVIDER_CREDENTIAL_ENCRYPTION_KEYRING=provider-credential-v1:replace-with-32-byte-base64url-secret
PROVIDER_CREDENTIAL_HINT_ACTIVE_KEY_ID=provider-credential-hint-v1
PROVIDER_CREDENTIAL_HINT_KEYRING=provider-credential-hint-v1:replace-with-32-byte-base64url-secret
STORAGE_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=storage-credential-v1
STORAGE_CREDENTIAL_ENCRYPTION_KEYRING=storage-credential-v1:replace-with-32-byte-base64url-secret
STORAGE_CREDENTIAL_HINT_ACTIVE_KEY_ID=storage-credential-hint-v1
STORAGE_CREDENTIAL_HINT_KEYRING=storage-credential-hint-v1:replace-with-32-byte-base64url-secret

ADMIN_INVITE_CODE_ENCRYPTION_ACTIVE_KEY_ID=admin-invite-v1
ADMIN_INVITE_CODE_ENCRYPTION_KEYRING=admin-invite-v1:replace-with-32-byte-base64url-secret
ADMIN_IDENTIFIER_HASH_ACTIVE_KEY_ID=admin-identifier-v1
ADMIN_IDENTIFIER_HASH_KEYRING=admin-identifier-v1:replace-with-32-byte-base64url-secret
ADMIN_SESSION_HASH_ACTIVE_KEY_ID=admin-session-v1
ADMIN_SESSION_HASH_KEYRING=admin-session-v1:replace-with-32-byte-base64url-secret
ADMIN_CSRF_DERIVATION_ACTIVE_KEY_ID=admin-csrf-v1
ADMIN_CSRF_DERIVATION_KEYRING=admin-csrf-v1:replace-with-32-byte-base64url-secret
ADMIN_CHALLENGE_HASH_ACTIVE_KEY_ID=admin-challenge-v1
ADMIN_CHALLENGE_HASH_KEYRING=admin-challenge-v1:replace-with-32-byte-base64url-secret
ADMIN_ENROLLMENT_HASH_ACTIVE_KEY_ID=admin-enrollment-v1
ADMIN_ENROLLMENT_HASH_KEYRING=admin-enrollment-v1:replace-with-32-byte-base64url-secret
ADMIN_IDEMPOTENCY_HASH_ACTIVE_KEY_ID=admin-idempotency-v1
ADMIN_IDEMPOTENCY_HASH_KEYRING=admin-idempotency-v1:replace-with-32-byte-base64url-secret
ADMIN_RECOVERY_HASH_ACTIVE_KEY_ID=admin-recovery-v1
ADMIN_RECOVERY_HASH_KEYRING=admin-recovery-v1:replace-with-32-byte-base64url-secret
ADMIN_SOURCE_HASH_ACTIVE_KEY_ID=admin-source-v1
ADMIN_SOURCE_HASH_KEYRING=admin-source-v1:replace-with-32-byte-base64url-secret
ADMIN_TOTP_ENCRYPTION_ACTIVE_KEY_ID=admin-totp-v1
ADMIN_TOTP_ENCRYPTION_KEYRING=admin-totp-v1:replace-with-32-byte-base64url-secret

MAIL_RECIPIENT_HASH_ACTIVE_KEY_ID=recipient-v1
MAIL_RECIPIENT_HASH_KEYRING=recipient-v1:replace-with-32-byte-base64url-secret
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.com

# Production must replace every local Origin/CIDR, set ADMIN_COOKIE_SECURE=true, and inject
# the approved mail provider's credentials in the API process only.
# Tests inject TEST_DATABASE_URL, TEST_REDIS_URL and TEST_REDIS_PREFIX only in the test runner.
