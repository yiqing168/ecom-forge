{
  "name": "@ecom-forge/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:worker": "vitest run --passWithNoTests",
    "test:e2e:s14-live": "pnpm --filter @ecom-forge/shared build && pnpm --filter @ecom-forge/db build && playwright test --config playwright.s14-live.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.23.0",
    "@ant-design/icons": "6.3.2",
    "@ant-design/nextjs-registry": "1.3.0",
    "@ant-design/pro-components": "2.8.10",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@ecom-forge/shared": "workspace:*",
    "antd": "5.29.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "otpauth": "9.4.1",
    "tailwindcss": "4.3.3"
  }
