{
  "name": "@ecom-forge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env.local --import tsx src/main.ts",
    "dev:watch": "node --conditions=development --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ops:approve-provider-model": "tsx src/ops/approve-provider-model.ts",
    "ops:bootstrap-admin": "tsx src/ops/bootstrap-admin.ts",
    "ops:create-invite": "tsx src/ops/create-invite.ts",
    "ops:register-provider-model": "tsx src/ops/register-provider-model.ts",
    "ops:recover-mail-deliveries": "tsx src/ops/recover-mail-deliveries.ts",
    "ops:recover-provider-circuit": "tsx src/ops/recover-provider-circuit.ts",
    "skill:install": "tsx src/ops/install-skill-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/integration/run-api-tests.mjs",
    "test:integration": "node ../../scripts/integration/run-api-tests.mjs test",
    "test:worker": "node ../../scripts/integration/run-api-tests.mjs"
  },
  "dependencies": {
    "@ecom-forge/agent": "workspace:*",
    "@ecom-forge/compiler": "workspace:*",
    "@ecom-forge/credit": "workspace:*",
    "@ecom-forge/db": "workspace:*",
    "@ecom-forge/provider": "workspace:*",
    "@ecom-forge/queue": "workspace:*",
    "@ecom-forge/shared": "workspace:*",
    "@ecom-forge/skills": "workspace:*",
    "@ecom-forge/storage": "workspace:*",
    "@ecom-forge/types": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "argon2": "0.44.0",
    "better-call": "1.3.7",
    "better-auth": "1.6.26",
    "express": "5.2.1",
    "ipaddr.js": "1.9.1",
    "nodemailer": "9.0.5",
    "otpauth": "9.4.1",
    "redis": "6.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
