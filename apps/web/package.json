{
  "name": "@ecom-forge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:worker": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:s03-live": "pnpm --filter @ecom-forge/shared build && playwright test --config playwright.s03-live.config.ts",
    "test:e2e:s06-live": "pnpm --filter @ecom-forge/shared build && playwright test --config playwright.s06-live.config.ts",
    "test:e2e:s10-live": "pnpm --filter @ecom-forge/shared build && playwright test --config playwright.s10-live.config.ts",
    "test:e2e:s11-live": "pnpm --filter @ecom-forge/shared build && playwright test --config playwright.s11-live.config.ts",
    "test:e2e:s12-live": "pnpm --filter @ecom-forge/worker... build && playwright test --config playwright.s12-live.config.ts"
  },
  "dependencies": {
    "@ecom-forge/shared": "workspace:*",
    "@ecom-forge/types": "workspace:*",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.16",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eventsource-parser": "3.0.6",
    "lucide-react": "1.29.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
